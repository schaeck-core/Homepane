# English: the reference language. Every key used in the code is defined
# here; other languages fall back to it for keys they do not have.
#
# Format: key = text. Placeholders {0}, {1}, ... stand for the values the
# code passes; each language orders them as it needs, but must use the same
# set (scripts/gen_i18n.py checks).
# @name: shown in the language list; @decimal: decimal separator;
# @glyphs: extra code point ranges for the text fonts (e.g. a script the
# language needs for Home Assistant names), see scripts/gen_fonts.py.
@name = English
@decimal = .
@glyphs =

